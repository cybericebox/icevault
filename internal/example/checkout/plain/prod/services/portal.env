# ===== Portal =====
# REQUIRED: the host readers open
PUBLIC_HOST=notes.example.net
CONTACT_ADDRESS=hello@example.net
BILLING_ACCOUNT=acct-77
# made once by the setup script
COOKIE_KEY=example-cookie-key
THEME_COLOR=teal
PORTAL_FLAGS=changelog
CHANGELOG_TAG=0.9.1

# ===== Sign-up =====
# REQUIRED: open or invite
SIGNUP_MODE=invite
ANALYTICS_ID=an-example-id
INVITE_SALT=example-invite-salt

# ===== CDN =====
# NEEDED FOR: serving files through the CDN
CDN_TOKEN=example-cdn-token
# NEEDED FOR: serving files through the CDN
CDN_PURGE_KEY=
# NEEDED FOR: serving files through the CDN
CDN_SIGNING_KEY=
