#!/usr/bin/env bash
#MISE description="Release asset for Linux into dist/: icevault-VERSION-linux-amd64.tar.gz (the command alone, no cgo). VERSION (the tag vX.Y.Z) is required"
#MISE quiet=true
set -euo pipefail
: "${VERSION:?VERSION (the tag, vX.Y.Z) is required}"
case "$VERSION" in v[0-9]*.[0-9]*.[0-9]*) ;; *) echo "release-assets-linux: VERSION is vX.Y.Z, not $VERSION" >&2; exit 1 ;; esac
cd "${MISE_PROJECT_ROOT:-$(pwd)}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags "-X github.com/cybericebox/icevault/internal/version.Version=$VERSION" -o "$tmp/icevault" ./cmd/icevault
mkdir -p dist
tar -czf "dist/icevault-$VERSION-linux-amd64.tar.gz" -C "$tmp" icevault
echo "dist/icevault-$VERSION-linux-amd64.tar.gz"
